# ============================================================
# EngineerPrep India — Environment Configuration Template
# Copy this file to .env and fill in all required values.
# NEVER commit a .env file containing real secrets.
# ============================================================

# ---- Application -----------------------------------------
NODE_ENV=development
# NODE_ENV=production

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ---- Database --------------------------------------------
# Required. Fail on startup if missing in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/engineerprep_db

# ---- Redis -----------------------------------------------
# Required for BullMQ automation queues.
REDIS_URL=redis://127.0.0.1:6379

# ---- JWT Secrets -----------------------------------------
# REQUIRED. Use strong random values in production:
#   node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
# Application will REFUSE to start in production if these are missing or default.
JWT_ACCESS_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_STRONG_RANDOM_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email (SMTP) ----------------------------------------
# Optional in development (email preview will be used instead).
# Required in production for password reset & verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="EngineerPrep India <noreply@engineerprep.in>"

# ---- File Storage ----------------------------------------
# STORAGE_TYPE=local     (for development — files saved in /uploads)
# STORAGE_TYPE=s3        (for production)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# S3-compatible object storage (required when STORAGE_TYPE=s3)
STORAGE_BUCKET=engineerprep-files
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_ENDPOINT=                     # Optional: custom S3 endpoint (e.g. MinIO)

# ---- Logging ---------------------------------------------
LOG_LEVEL=info
# LOG_LEVEL=debug   (verbose — development only)

# ---- Rate Limiting ---------------------------------------
# Max login attempts per IP per 15-minute window
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900

# ---- Admin Bootstrap -------------------------------------
# Used by the admin:seed script to create the first admin account.
# Remove from env after initial setup.
INITIAL_ADMIN_EMAIL=admin@engineerprep.in
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- CORS ------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

