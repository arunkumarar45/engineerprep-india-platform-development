{
    "name": "nextjs-postgresql-template",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "db:push": "drizzle-kit push --config=drizzle.config.ts",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "db:seed": "tsx --env-file=.env scripts/seed.ts",
        "worker": "tsx src/workers/worker.ts",
        "admin:create": "tsx --env-file=.env scripts/admin-create.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1163.0",
        "@node-rs/argon2": "^2.2.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/nodemailer": "^8.0.2",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.6.0",
        "cors": "^2.8.6",
        "date-fns": "^4.4.0",
        "dotenv": "17.3.1",
        "drizzle-orm": "0.45.2",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jose": "^6.2.15",
        "lucide-react": "^1.67.0",
        "multer": "^2.5.0",
        "next": "16.2.6",
        "nodemailer": "^10.3.1",
        "pg": "8.20.0",
        "rate-limiter-flexible": "^11.2.4",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "uuid": "^14.0.3",
        "vitest": "^5.1.0",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.1.17",
        "@types/node": "22.19.15",
        "@types/pg": "8.18.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "postcss": "8.5.8",
        "tailwindcss": "4.1.17",
        "typescript": "5.9.3",
        "vite": "^8.3.5"
    }
}
