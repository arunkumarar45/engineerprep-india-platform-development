# ============================================================
# ENGINEERPREP INDIA — CLOUDFLARE PAGES PRODUCTION ENV VARS
# ============================================================
# Set these as SECRETS in Cloudflare Pages dashboard or via:
#   npx wrangler pages secret put <KEY> --project-name engineerprep-india
# Never commit real values.

# ----- Cloudflare marker (set automatically by CF Pages) -----
CF_PAGES=1

# ----- Neon PostgreSQL (get from neon.tech) -----
# Use the POOLED connection string (not direct)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/engineerprep?sslmode=require

# ----- JWT Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") -----
JWT_ACCESS_SECRET=<64-char-random-hex>
JWT_REFRESH_SECRET=<64-char-random-hex>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- App URL (your Cloudflare Pages URL or custom domain) -----
FRONTEND_URL=https://engineerprep-india.pages.dev
NEXT_PUBLIC_API_URL=https://engineerprep-india.pages.dev

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# IMPORTANT: Update this to your CF Pages URL after first deploy
GOOGLE_CALLBACK_URL=https://engineerprep-india.pages.dev/api/v1/auth/google/callback

# ----- Security -----
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Storage (Cloudflare R2 — optional, configure after launch) -----
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=50

# ----- Admin Bootstrap (used only on first seed) -----
INITIAL_ADMIN_EMAIL=admin@engineerprep.in
INITIAL_ADMIN_PASSWORD=Admin@SecurePassword123!
INITIAL_ADMIN_NAME=Platform Admin
